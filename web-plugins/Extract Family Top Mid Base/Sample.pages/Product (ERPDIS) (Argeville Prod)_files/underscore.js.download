<!doctype html>
<html dir="ltr">

<head>
    <title>Sage</title>
    <meta content="text/html; charset=UTF-8" http-equiv="content-type">
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <link rel="icon" href="/syracuse-main/html/styles/images/site/favicon.svg">

    <!-- Use minimum-scale=1 to enable GPU rasterization -->
    <meta name="viewport"
        content="width=device-width, initial-scale=1, user-scalable=0, maximum-scale=1, minimum-scale=1">
    <meta name="theme-color" content="#582C83">
    <meta name="msapplication-navbutton-color" content="#582C83">
    <meta name="apple-mobile-web-app-status-bar-style" content="#582C83">
    <link rel="stylesheet" type="text/css" href="styles/base.css" />
    <link rel="stylesheet" type="text/css" href="/syracuse-react/dist/styles/app.css">
    <link rel="stylesheet" type="text/css" href="/syracuse-ui/deps/jquery-ui/css/ui-lightness/jquery-ui.css">
    <script src="/streamline-require/lib/client/require.js">
    </script>
    <script src="/syracuse-ui/deps/underscore.js">
    </script>
    <script src="/syracuse-ui/deps/md5.min.js">
    </script>
    <script type="text/javascript" src="/syracuse-ui/deps/html-sanitizer/html-css-sanitizer.js">
    </script>
    <script src="/syracuse-ui/deps/jquery/jquery-3.6.0.min.js">
    </script>
    <script src="/syracuse-ui/deps/jquery-ui/jquery-ui.min.js">
    </script>
</head>

<body>
    <script>
        if (!window.console) {
            window.console = {
                log: function () { },
                error: function () { },
                warn: function () { }
            };
        }
        window.requireSourceHook = function (source, url) {
            var comment = false;
            return source.split('\n').map(function (str, line) {
                var open = str.lastIndexOf('/' + '*');
                var close = str.lastIndexOf('*' + '/');
                var quotes = 1 + str.indexOf("'") + str.indexOf('"');
                if (!comment && open > close)
                    comment = true;
                else
                    if (comment && close > open)
                        comment = false;

                return comment || open >= 0 || close >= 0 || quotes >= 0 ? str : str.replace(
                    /(function\s*\w*\s*)\(/g,
                    function (s, fn) {
                        return fn + "/" + "*" + url + ':' + (line + 1) + "*" + "/(";
                        //                    }).replace(/\bdebugger\b/g, 'alert("debugger: " + getStack())');
                    }).replace(/\bdebugger\b/g, '');
            }).join('\n');
        }

        $(document).ready(function () {
            if (!console.warn) {
                console.warn = console.log;
            }
            require.main("syracuse-main/html/main");
        });
    </script>
</body>

</html>